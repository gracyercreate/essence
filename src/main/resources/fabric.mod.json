{
  "schemaVersion": 1,
  "id": "skinselector",
  "version": "${version}",
  "name": "Skin Selector",
  "description": "Shows a Bedrock-style character picker (Sunny, Kai, Makena, Steve, Alex, Zuri, Efe, Ari, Noor - wide/slim) when you create a new world.",
  "authors": [],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.skinselector.client.SkinSelectorClient"]
  },
  "mixins": ["skinselector.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
